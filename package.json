{
  "name": "aws-console",
  "version": "4.1.0",
  "description": "AWS Console",
  "main": "./out/main/index.js",
  "author": "Philip Dowie <philip@jnawk.nz>",
  "homepage": "https://github.com/jnawk/aws-electron/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnawk/aws-electron.git"
  },
  "bugs": {
    "url": "https://github.com/jnawk/aws-electron/issues"
  },
  "keywords": [
    "AWS"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "models": "(cd models; npm run build)",
    "dev": "npm run models; electron-vite dev --clearScreen false",
    "build": "cd models && npm run build && cd .. && npm run typecheck && electron-vite build --clearScreen false",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@aws-sdk/client-sso-oidc": "^3.848.0",
    "@coreui/coreui": "^5.4.1",
    "@coreui/react": "^5.7.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "models": "file:models"
  },
  "devDependencies": {
    "@aws-sdk/client-sts": "^3.848.0",
    "@aws-sdk/credential-providers": "^3.848.0",
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@types/ini": "^4.1.1",
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sprintf-js": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@vitejs/plugin-react": "^4.7.0",
    "debounce": "^2.2.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "electron-settings": "^4.0.4",
    "electron-updater": "^6.6.2",
    "electron-vite": "^4.0.0",
    "eslint-plugin-react": "^7.37.5",
    "ini": "^5.0.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sprintf-js": "^1.1.3",
    "typescript": "<5.6.0",
    "urllib": "^4.8.0",
    "vite": "^7.0.6"
  }
}
